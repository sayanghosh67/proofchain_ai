# Public Supabase project settings (safe for browser use)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server settings: same Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only: never use a VITE_ prefix for secrets
GEMINI_API_KEY=
# Set a model available to your API key. Availability is checked on first call.
GEMINI_MODEL=
